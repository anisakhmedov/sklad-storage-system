# Строка подключения к MongoDB (Atlas или локальный инстанс)
MONGODB_URI=mongodb://localhost:27017/sklad

# Токен Telegram-бота от @BotFather (без него бот не запустится — см. README)
TELEGRAM_BOT_TOKEN=

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token от Telegram (опционально,
# но рекомендуется в проде) — любая случайная строка, задаётся также в scripts/setWebhook.ts
TELEGRAM_WEBHOOK_SECRET=

# Публичный URL приложения — используется для ссылки на Mini App и регистрации webhook
APP_BASE_URL=http://localhost:3000

# Секрет для подписи JWT-сессии веб-панели (например: openssl rand -hex 32)
NEXTAUTH_SECRET=dev-insecure-secret-change-me

# Используются только scripts/seed.ts для создания первого владельца веб-панели
OWNER_IDENTIFIER=owner
OWNER_PASSWORD=change-me-123

# Секрет для напоминаний об обходе холодильных камер (см. vercel.json, app/api/cron/patrol-reminder).
# На Vercel: задайте этот же секрет в Project Settings → Environment Variables — Vercel Cron
# автоматически прикладывает его в заголовке Authorization при вызове по расписанию. Работает
# только при деплое на Vercel (Cron Jobs — фича Vercel); при другом хостинге понадобится
# внешний cron, дёргающий тот же URL с этим же заголовком.
CRON_SECRET=
